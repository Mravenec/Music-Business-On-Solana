  subgraph chain [Program GUY7o. v0.10.0 DevNet USDC]
    Config["Eh8sConfig PDA eh8s,config: mint, treasury ATA, vault ATA, fee bps"]
    AcademyIx["subscribe_academy(plan, months) 85 treasury / 15 instructor; AcademySubscription expires_at"]
    GeoIx["subscribe_geographic(geo_code, tier, months) 100 treasury; GeographicSubscription expires_at"]
    BandVaultIx["create_band / update_spp_weights: BandVault PDA band,id (members + weights bps)"]
    SettleIx["settle_concert(concert_id, gross, expenses): net fee by config bps to treasury + pool to vault + split pending by weight; PDA concert,venue,id once"]
    VenueIx["register_venue / approve_venue: VenueListing PDA venue,wallet,id"]
    EscrowIx["propose_booking: gross to escrow of VenueAccessToken access,wallet,band,date; confirm_booking pins contract SHA-256; cancel_booking refunds"]
    SettleBookingIx["settle_booking(gross, expenses): expenses to venue, fee to treasury, pool to vault, pending by weight"]
    PoolIx["create_royalty_pool / deposit_royalties: RoyaltyPool royalty,track splits bps"]
    SyncIx["pay_sync_license: 20 treasury / 80 vault by song splits; SyncLicense sync,track,deal once"]
    AgentAuth["authorize_agent: AgentAuthority PDA agent,wallet permission bits"]
    LevelIx["update_musician_level: owner or NEXUS agent"]
    Treasury["Treasury PDA treasury: USDC ATA 9ptwWx."]
    Vault["Vault ATA"]
    ClaimIx["claim_royalties vault to musician ATA (ATA created idempotent)"]
    WithdrawIx["withdraw_treasury(amount): config.owner only, treasury PDA signs; refused once governance exists"]
    GovIx["init_governance / propose / approve_proposal / execute_withdraw_proposal: Governance PDA 3ZH4ig."]
  end
  subgraph backend [Spring 8080]
    Verifier["SolanaRpcClient verifies program, accounts, amounts"]
    Digest["OwnerDigestService: MariaDB metrics + treasury balance -> Claude -> owner_digest"]
    AgentsLive["NEXUS Score Enigma (Claude) / HARMONY match / ATLAS tour route -> agent_event_log"]
    SlackBridge["Slack Block Kit Approve / Reject -> POST /api/slack/interactions (signed) -> owner_decision once"]
    CourseAccess["CourseService: free preview, owner grant, or active academy plan + course min level; locked = no video link"]
  end
