# Copy values into the shell or an untracked local env file — never commit real tokens.
# Used by Spring (eh8s.slack.*) and optionally the desktop der-dirigent bot.

EH8S_SLACK_WEBHOOK_URL=
EH8S_SLACK_BOT_TOKEN=
EH8S_SLACK_CHANNEL_ID=
EH8S_SLACK_CHANNEL_HINT=#eh8s-owner
# Slack app > Basic Information > Signing Secret. Point Interactivity & Shortcuts > Request URL at
# https://<public tunnel>/api/slack/interactions. Blank = Approve / Reject clicks are refused (503).
SLACK_SIGNING_SECRET=

# Claude owner digest - blank key = AI disabled, POST /api/owner/digest/run returns 503.
ANTHROPIC_API_KEY=
EH8S_CLAUDE_MODEL=claude-sonnet-4-5

# Desktop der-dirigent-bot (Socket Mode) — keep in that bot's own .env, not in git:
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
